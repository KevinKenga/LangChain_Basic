# Copy this file to .env and fill in the values.
# azure_setup/provision.sh prints every value below once it has created the resources.
# Never commit .env -- it holds keys.

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Deployment names (provision.sh names each deployment after its model)
AZURE_OPENAI_GENERATION_DEPLOYMENT=gpt-5.1
AZURE_OPENAI_GUARDRAIL_DEPLOYMENT=gpt-5.1
# The router and the grader return small JSON objects. Point this at whatever
# small model you deployed; leave it empty to reuse the guardrail deployment.
AZURE_OPENAI_FAST_DEPLOYMENT=gpt-5.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=supply-chain

# --- Azure Blob Storage ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=supply-chain-docs
# The blob trigger writes to these two. They must differ from the container
# above, or the trigger would fire again on its own markdown output.
AZURE_MARKDOWN_CONTAINER=supply-chain-markdown
AZURE_RESULTS_CONTAINER=supply-chain-results

# --- Where upload_pdfs.py finds the five PDFs on your computer ---
LOCAL_PDF_DIR=./data/raw

# --- Azure Application Insights (optional) ---                       NEW
# Leave empty to run without monitoring. docs/architecture/webapps.md, Step 16, fills it in on Azure.
APPLICATIONINSIGHTS_CONNECTION_STRING=