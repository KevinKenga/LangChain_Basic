{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "AzureWebJobsStorage": "DefaultEndpointsProtocol=https;AccountName=<your-storage-account>;AccountKey=<your-storage-key>;EndpointSuffix=core.windows.net",
    "BLOB_TRIGGER_PATH": "supply-chain-docs/{name}",
    "AZURE_OPENAI_ENDPOINT": "https://<your-openai-resource>.openai.azure.com/",
    "AZURE_OPENAI_API_KEY": "<your-openai-key>",
    "AZURE_OPENAI_API_VERSION": "2025-04-01-preview",
    "AZURE_OPENAI_GENERATION_DEPLOYMENT": "gpt-4o",
    "AZURE_OPENAI_GUARDRAIL_DEPLOYMENT": "gpt-4o-mini",
    "AZURE_OPENAI_FAST_DEPLOYMENT": "gpt-4o-mini",
    "AZURE_OPENAI_EMBEDDING_DEPLOYMENT": "text-embedding-3-small",
    "AZURE_SEARCH_ENDPOINT": "https://<your-search-service>.search.windows.net",
    "AZURE_SEARCH_API_KEY": "<your-search-admin-key>",
    "AZURE_SEARCH_INDEX": "supply-chain",
    "AZURE_STORAGE_CONNECTION_STRING": "DefaultEndpointsProtocol=https;AccountName=<your-storage-account>;AccountKey=<your-storage-key>;EndpointSuffix=core.windows.net",
    "AZURE_STORAGE_CONTAINER": "supply-chain-docs",
    "AZURE_MARKDOWN_CONTAINER": "supply-chain-markdown",
    "AZURE_RESULTS_CONTAINER": "supply-chain-results",
    "TRIGGER_QUESTION": "Summarise the key figures and risks in the newly uploaded document: {doc_title}",
    "APPLICATIONINSIGHTS_CONNECTION_STRING": "",
    "SCM_DO_BUILD_DURING_DEPLOYMENT": "true",
    "ENABLE_ORYX_BUILD": "true"
  }
}
